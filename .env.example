# 环境变量说明（docker-compose 从仓库根目录的 .env 读取；本文件仅作文档）
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 知识库根目录（容器内固定为 /app/vault，由 volume 挂载）----
# KB_ROOT=/app/vault

# ---- PostgreSQL 连接（容器内主机名为服务名 db）----
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=llmwiki
# DB_USER=llmwiki
# DB_PASS=llmwiki

# ---- Phase 2 SP2：API 与认证 ----
# API_BASE=http://localhost:8000          # Streamlit 消费 API 的地址（容器内为 http://api:8000）
# JWT_SECRET=<生成随机串，≥32 字符>         # 必填；HS256 签名密钥（生产环境 fail-fast）
# ADMIN_INIT_USER=admin                   # 初始管理员用户名（users 表为空时创建）
# ADMIN_INIT_PASS=admin123                # 初始管理员密码（生产环境需 ≥12 字符且非默认值）
# APP_ENV=development                     # production 时强制校验强密钥/强密码

# ---- Phase 2 SP4：向量检索（混合检索的语义通道）----
# DASHSCOPE_API_KEY=sk-xxxxxxxx           # 阿里云 DashScope；未配置时 /search 自动降级 grep-only
                                          # 模型固定 text-embedding-v4（1024 维），换模型需 /admin/backfill-embeddings 全量重算

# ---- Phase 2 SP2.5：可观测性探针（可选，零侵入）----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ---- 知识层 LLM 引擎（不在容器内，由宿主机 Claude Code 使用）----
# ANTHROPIC_BASE_URL=                     # Claude Code 的 LLM 通道；watcher 启动前会预检
# WATCHER_INTERVAL=5                      # 触发队列轮询间隔（秒）
# WATCHER_TIMEOUT=900                     # 单次 claude 执行超时（秒）
# WATCHER_PERMISSION_MODE=acceptEdits     # 无人值守默认受限权限；bypassPermissions 需显式开启
